# Copy this to `.env` before running `docker compose up`.
# Defaults are reasonable for a single-host install.
#
# Running a SECOND Sill on this host: every commented-out name below has to
# change, not just SILL_DB_CONTAINER. docker-compose.yml names four
# containers and binds three host ports, and the Compose project name (which
# prefixes the volume names) defaults to the directory it runs from —
# `backend`, identically for every clone. See the README's "Run a second Sill
# side by side". install.sh, verify.sh, and upgrade.sh all read this file.

# --- Compose project (volume-name prefix) ---
# COMPOSE_PROJECT_NAME=sill

# --- Network exposure ---
# Which host interface the published ports bind to. Default 0.0.0.0 is every
# interface, which is what this file has always produced.
#
# Worth a deliberate decision rather than a default, because of what is behind
# those ports: the database runs with POSTGRES_HOST_AUTH_METHOD=trust, so it
# asks for no password at all — anything that can reach 5432 is a superuser on
# the entire memory store, and the db image carries pgsql-http, so that also
# means outbound HTTP from inside the container network. RabbitMQ's management
# UI on 15672 has known credentials sitting a few lines below this comment.
#
# Nothing in a single-host install needs those ports off-box: the hooks reach
# Postgres by `docker exec`, and the MCP server connects to localhost. So
# unless another machine genuinely has to connect, bind to loopback:
#
#   SILL_BIND_ADDR=127.0.0.1
#
# Left at the default, an untrusted network (a cafe, a conference, a shared
# office) is a network on which your memory store is readable and writable by
# anyone on it.
# SILL_BIND_ADDR=0.0.0.0

# --- Postgres ---
# Container name lets multiple Sill instances coexist (e.g. test vs prod).
SILL_DB_CONTAINER=sill_db
POSTGRES_DB=sill
POSTGRES_USER=sill
POSTGRES_PASSWORD=sill_password
# Bump if 5432 collides with another Postgres on this host.
POSTGRES_PORT=5432

# --- Embeddings ---
# LOCKED at install. Changing the model later requires a schema rebuild
# because vector column types are wired to EMBEDDING_DIMENSION via
# the app.embedding_dimension Postgres GUC.
# First boot downloads ~1.2 GB of float32 weights (the "300m" is parameters).
EMBEDDING_MODEL_ID=unsloth/embeddinggemma-300m
EMBEDDING_DIMENSION=768
# SILL_EMBEDDINGS_CONTAINER=sill_embeddings

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=sill
RABBITMQ_DEFAULT_PASS=sill_password
RABBITMQ_PORT=5672
# Host ports must be <= 65535.
RABBITMQ_MANAGEMENT_PORT=15672
# SILL_RABBITMQ_CONTAINER=sill_rabbitmq

# --- Maintenance worker ---
# SILL_MAINTENANCE_WORKER_CONTAINER=sill_maintenance_worker

# --- Hook environment (read by plugin/hooks/*) ---
# Path to an installed episodic-memory plugin. Unset = degrade gracefully.
# SILL_EPISODIC_MEMORY_PATH=
